# ============================================================
# DENTAL DAY API — Variables de Entorno
# ============================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena CADA valor antes de correr el proyecto
# 3. NUNCA subas el archivo .env a Git
# ============================================================

# ── SERVIDOR ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── BASE DE DATOS ─────────────────────────────────────────────
DATABASE_URL=postgresql://dental_user:dental_pass@localhost:5432/dental_day_db

# ── SEGURIDAD / JWT ───────────────────────────────────────────
# Genera un valor con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── BCRYPT ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── CLÍNICA ───────────────────────────────────────────────────
# Zona horaria IANA de la clínica. "Hoy" y "ahora" se calculan aquí,
# no en la zona del servidor (Render y Neon corren en UTC).
CLINIC_TIMEZONE=America/Managua

# ── CONTROL DE FECHAS (npm run check:dates) ───────────────────
# Solo para el script de control; usuario admin o dentist.
# CHECK_API_URL=https://tu-api.onrender.com
# CHECK_EMAIL=
# CHECK_PASSWORD=
